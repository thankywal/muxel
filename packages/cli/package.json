{
  "name": "muxel",
  "version": "0.1.0",
  "description": "Provision and operate a Muxel deployment inside your own Cloudflare account",
  "license": "Apache-2.0",
  "author": "thankywal",
  "homepage": "https://github.com/thankywal/muxel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thankywal/muxel.git",
    "directory": "packages/cli"
  },
  "keywords": ["cloudflare", "workers", "telegram", "rag", "self hosted"],
  "type": "module",
  "bin": {
    "muxel": "./dist/index.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@muxel/core": "workspace:*"
  }
}
