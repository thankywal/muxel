{
  "name": "@muxel/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Muxel Worker runtime: webhook ingress, admin console, retrieval and inference",
  "license": "Apache-2.0",
  "author": "thankywal",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply muxel --local",
    "migrate:remote": "wrangler d1 migrations apply muxel --remote"
  },
  "dependencies": {
    "@muxel/core": "workspace:*"
  }
}
